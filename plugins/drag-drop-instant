#!/bin/sh

SELECTION=${NNN_SEL:-${XDG_CONFIG_HOME:-$HOME/.config}/nnn/.selection}
DND="dragon"
DND_ARG="-a -x -T"

if [ -s "$SELECTION" ]; then
  sed -z 's|'"$PWD/"'||g;' < "$SELECTION" | xargs -0 setsid -f "$DND" $DND_ARG
else
  setsid -f "$DND" $DND_ARG "$1"
fi

[ $? -eq 0 ] && printf "-" > "$NNN_PIPE"
